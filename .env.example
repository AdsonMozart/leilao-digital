# Gerar o arquivo local com: python scripts/setup_env.py
# Senhas vazias impedem que o Compose inicialize sem configuracao.
MYSQL_DATABASE=leilao_digital
MYSQL_USER=leilao_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Porta no Windows; dentro da rede Docker o MySQL continua usando 3306.
MYSQL_PORT=3307

# Reservadas para as proximas etapas; ainda nao utilizadas pelos servicos.
DJANGO_SECRET_KEY=
AUDIT_HMAC_KEY=
